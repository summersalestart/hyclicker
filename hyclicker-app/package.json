{
  "name": "hyclicker",
  "productName": "HyClicker",
  "version": "1.2.0",
  "description": "HyClicker rebuilt with HTML + CSS + JS (Electron)",
  "author": "summersalestart",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hyclicker.app",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "HyClicker.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ]
  },
  "allowScripts": {
    "electron@44.9.0": true,
    "electron-winstaller@5.4.0": true
  }
}
